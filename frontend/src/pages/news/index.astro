---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Base title="News — OptiArk">
  <Nav active="news" />
  <main class="page">
    <div class="page-inner">
      <h1 class="page-title">News</h1>
      <p class="page-sub">Updates, tips, and announcements for OptiArk.</p>
      <div id="postsLoading" class="loading-msg">Loading posts…</div>
      <div id="postsError" class="err" style="display:none"></div>
      <div class="posts" id="postsList"></div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const API_BASE = ((import.meta as any).env?.PUBLIC_API_URL ?? 'https://oaapi.arc360hub.com').replace(/\/$/, '');

  const tagVar: Record<string, string> = { green: 'accent', blue: 'accent2', yellow: 'warn', red: 'danger' };

  async function loadNews() {
    const loading = document.getElementById('postsLoading') as HTMLElement | null;
    const errEl = document.getElementById('postsError') as HTMLElement | null;
    const list = document.getElementById('postsList');

    try {
      const news: any[] = await fetch(`${API_BASE}/api/news`).then(r => r.json());
      if (loading) loading.style.display = 'none';
      if (list) {
        list.innerHTML = news.map(post => `
          <a href="/news/${post.id}" class="post-row">
            <div class="post-meta">
              <span class="post-tag" style="color:var(--${tagVar[post.tagColor] ?? 'accent'})">${post.tag ?? ''}</span>
              <span class="post-date">${new Date(post.date).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</span>
            </div>
            <h2 class="post-title">${post.title ?? ''}</h2>
            <p class="post-summary">${post.summary ?? ''}</p>
          </a>`).join('');
      }
    } catch {
      if (loading) loading.style.display = 'none';
      if (errEl) { errEl.textContent = 'Could not load news.'; errEl.style.display = 'block'; }
    }
  }

  loadNews();
</script>

<style>
.page { padding: 60px 24px; }
.page-inner { max-width: 780px; margin: 0 auto; }
.page-title { font-family: var(--font-head); font-size: 2.5rem; font-weight: 700; margin-bottom: 8px; }
.page-sub { color: var(--muted); margin-bottom: 40px; }
.loading-msg { color: var(--muted); font-size: 0.9rem; }
.err { color: var(--danger); }

.posts { display: flex; flex-direction: column; gap: 2px; }
.post-row {
  display: flex; flex-direction: column; gap: 8px;
  padding: 24px;
  border-radius: 10px;
  border: 1px solid transparent;
  text-decoration: none;
  transition: background 0.15s, border-color 0.15s;
}
.post-row:hover { background: var(--surface); border-color: var(--border); text-decoration: none; }
.post-meta { display: flex; align-items: center; gap: 12px; }
.post-tag { font-size: 0.75rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
.post-date { font-size: 0.8rem; color: var(--muted); }
.post-title { font-family: var(--font-head); font-size: 1.4rem; font-weight: 700; color: var(--text); }
.post-summary { color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
</style>
