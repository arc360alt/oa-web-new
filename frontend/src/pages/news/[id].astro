---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const { id } = Astro.params;
---

<Base title="OptiArk News">
  <Nav active="news" />
  <main class="page" data-post-id={id}>
    <div class="page-inner">
      <a href="/news" class="back">← Back to News</a>
      <div id="postLoading" class="loading-msg">Loading…</div>
      <div id="postError" class="err" style="display:none"></div>
      <article id="postContent" style="display:none">
        <div class="article-meta">
          <span class="tag" id="postTag"></span>
          <span class="date" id="postDate"></span>
        </div>
        <h1 class="article-title" id="postTitle"></h1>
        <p class="article-summary" id="postSummary"></p>
        <div class="divider"></div>
        <div class="article-body" id="postBody"></div>
      </article>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const API_BASE = ((import.meta as any).env?.PUBLIC_API_URL ?? 'https://oaapi.arc360hub.com').replace(/\/$/, '');
  const id = (document.querySelector('main') as HTMLElement | null)?.dataset.postId ?? '';

  const tagVar: Record<string, string> = { green: 'accent', blue: 'accent2', yellow: 'warn', red: 'danger' };

  async function loadPost() {
    const loading = document.getElementById('postLoading');
    const errEl = document.getElementById('postError');
    const content = document.getElementById('postContent');

    try {
      const post = await fetch(`${API_BASE}/api/news/${id}`).then(r => {
        if (!r.ok) throw new Error('not found');
        return r.json();
      });

      document.title = `${post.title} — OptiArk`;

      const tagEl = document.getElementById('postTag');
      if (tagEl) {
        tagEl.textContent = post.tag ?? '';
        tagEl.style.color = `var(--${tagVar[post.tagColor] ?? 'accent'})`;
      }
      const dateEl = document.getElementById('postDate');
      if (dateEl) dateEl.textContent = new Date(post.date).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'});
      const titleEl = document.getElementById('postTitle');
      if (titleEl) titleEl.textContent = post.title ?? '';
      const summaryEl = document.getElementById('postSummary');
      if (summaryEl) summaryEl.textContent = post.summary ?? '';
      const bodyEl = document.getElementById('postBody');
      if (bodyEl) bodyEl.innerHTML = ((post.body ?? '') as string).split('\n\n').map(p => `<p>${p}</p>`).join('');

      if (loading) loading.style.display = 'none';
      if (content) content.style.display = 'block';
    } catch {
      if (loading) loading.style.display = 'none';
      if (errEl) { errEl.textContent = 'Post not found.'; errEl.style.display = 'block'; }
    }
  }

  loadPost();
</script>

<style>
.page { padding: 60px 24px; }
.page-inner { max-width: 720px; margin: 0 auto; }
.back { color: var(--muted); font-size: 0.85rem; display: inline-block; margin-bottom: 32px; }
.back:hover { color: var(--accent); text-decoration: none; }
.loading-msg { color: var(--muted); font-size: 0.9rem; }
.err { color: var(--danger); }

article { display: flex; flex-direction: column; gap: 16px; }
.article-meta { display: flex; align-items: center; gap: 12px; }
.tag { font-size: 0.75rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
.date { font-size: 0.8rem; color: var(--muted); }
.article-title {
  font-family: var(--font-head);
  font-size: clamp(1.8rem, 5vw, 2.8rem);
  font-weight: 700;
  line-height: 1.15;
}
.article-summary { color: var(--muted); font-size: 1.05rem; line-height: 1.6; }
.divider { height: 1px; background: var(--border); margin: 8px 0; }
.article-body { display: flex; flex-direction: column; gap: 16px; }
.article-body p { color: var(--text); line-height: 1.75; font-size: 0.97rem; white-space: pre-wrap; }
</style>
