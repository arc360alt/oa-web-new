---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import DownloadSelector from "../components/DownloadSelector.astro";
import Features from "../components/Features.astro";
import Performance from "../components/Performance.astro";
import Footer from "../components/Footer.astro";
---

<Base title="OptiArk — Minecraft Performance Modpack">
  <Nav active="home" />
  <Hero />
  <DownloadSelector />
  <Features />
  <Performance />

  <section class="news-strip" id="newsStrip" style="display:none">
    <div class="strip-inner">
      <div class="strip-header">
        <h2 class="strip-title">Latest News</h2>
        <a href="/news" class="strip-more">All posts →</a>
      </div>
      <div class="news-cards" id="newsCards"></div>
    </div>
  </section>

  <Footer />
</Base>

<script>
  declare global {
    interface Window {
      renderDownloads?: (categories: Record<string, any>, versionBackgrounds: Record<string, string>) => void;
    }
  }

  const API_BASE = ((import.meta as any).env?.PUBLIC_API_URL ?? 'https://oaapi.arc360hub.com').replace(/\/$/, '');

  async function initPage() {
    try {
      const [downloadsData, newsData] = await Promise.all([
        fetch(`${API_BASE}/api/downloads`).then(r => r.json()),
        fetch(`${API_BASE}/api/news`).then(r => r.json()),
      ]);

      // Banner
      if (downloadsData.banner?.active) {
        const banner = document.getElementById('siteBanner') as HTMLElement | null;
        const link = document.getElementById('siteBannerLink') as HTMLAnchorElement | null;
        if (banner && link) {
          link.href = downloadsData.banner.link ?? '#';
          link.textContent = downloadsData.banner.message ?? '';
          banner.style.display = 'block';
        }
      }

      // Downloads section
      window.renderDownloads?.(downloadsData.categories, downloadsData.versionBackgrounds);

      // News strip
      const posts: any[] = Array.isArray(newsData) ? newsData.slice(0, 3) : [];
      if (posts.length > 0) {
        const strip = document.getElementById('newsStrip') as HTMLElement | null;
        const cards = document.getElementById('newsCards');
        if (cards) {
          const tagVar = (t: string) => t === 'green' ? 'accent' : t === 'blue' ? 'accent2' : 'warn';
          cards.innerHTML = posts.map(post => `
            <a href="/news/${post.id}" class="news-card">
              <div class="card-tag" style="color:var(--${tagVar(post.tagColor)})">${post.tag ?? ''}</div>
              <div class="card-title">${post.title ?? ''}</div>
              <p class="card-summary">${post.summary ?? ''}</p>
              <span class="card-date">${new Date(post.date).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span>
            </a>`).join('');
        }
        if (strip) strip.style.display = 'block';
      }
    } catch (e) {
      console.error('Failed to load page data:', e);
    }
  }

  initPage();
</script>

<style>
.news-strip { padding: 60px 24px; border-top: 1px solid var(--border); }
.strip-inner { max-width: 1100px; margin: 0 auto; }
.strip-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; }
.strip-title { font-family: var(--font-head); font-size: 1.8rem; font-weight: 700; }
.strip-more { color: var(--accent); font-size: 0.9rem; }

.news-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
.news-card {
  display: flex; flex-direction: column; gap: 8px;
  padding: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  text-decoration: none;
  transition: border-color 0.2s, transform 0.2s;
}
.news-card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }
.card-tag { font-size: 0.75rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }
.card-title { font-family: var(--font-head); font-size: 1.15rem; font-weight: 600; color: var(--text); }
.card-summary { color: var(--muted); font-size: 0.85rem; line-height: 1.5; flex: 1; }
.card-date { font-size: 0.78rem; color: var(--muted); margin-top: 4px; }
</style>
