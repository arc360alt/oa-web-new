---
// DownloadSelector — data is fetched client-side on every page load
---

<section class="downloads" id="downloads">
  <div class="section-inner">
    <h2 class="section-title">Downloads</h2>
    <p class="section-sub">Choose your renderer and Minecraft version below.</p>

    <div id="dlSpinner" class="dl-spinner">Loading versions…</div>

    <!-- Tech tabs (populated by renderDownloads) -->
    <div class="tabs" id="techTabs" style="display:none"></div>

    <!-- Per-tech panels (populated by renderDownloads) -->
    <div id="techPanels"></div>

    <!-- Download card -->
    <div class="dl-card" id="dlCard" style="display:none">
      <div class="dl-bg" id="dlBg"></div>
      <div class="dl-content">
        <div class="dl-info">
          <span class="dl-version" id="dlVersion">—</span>
          <span class="dl-note" id="dlNote"></span>
        </div>
        <a class="dl-btn" id="dlBtn" href="#" target="_blank">Download ↓</a>
      </div>
    </div>
    <p class="dl-hint" id="dlHint" style="display:none">← Select a version above</p>
  </div>
</section>

<!-- Beta warning modal -->
<div class="modal-overlay" id="betaModal">
  <div class="modal modal-beta">
    <div class="modal-icon">🧪</div>
    <h3 class="modal-title beta-title">Beta Version</h3>
    <p class="modal-body">
      This version is a <strong>work in progress</strong>. It may be unstable, incomplete, or contain bugs.
    </p>
    <div class="beta-mods-section" id="betaModsSection" style="display:none">
      <p class="beta-mods-label">Mods not yet supported in this beta:</p>
      <ul class="beta-mods-list" id="betaModsList"></ul>
    </div>
    <div class="modal-actions">
      <button class="modal-cancel" id="betaModalCancel">Go Back</button>
      <a class="modal-confirm beta-confirm" id="betaDlBtn" href="#" target="_blank">Download Anyway</a>
    </div>
  </div>
</div>

<!-- Legacy warning modal -->
<div class="modal-overlay" id="legacyModal">
  <div class="modal">
    <div class="modal-icon">⚠</div>
    <h3 class="modal-title">Legacy Version</h3>
    <p class="modal-body">
      This version is <strong>no longer supported</strong> and may be broken, outdated, or missing mods.
      It will not receive future updates or bug fixes.<br /><br />
      Download and use it at your own risk.
    </p>
    <div class="modal-actions">
      <button class="modal-cancel" id="legacyModalCancel">Go Back</button>
      <a class="modal-confirm" id="modalDlBtn" href="#" target="_blank">Download Anyway</a>
    </div>
  </div>
</div>

<style is:global>
.downloads { padding: 80px 24px; }
.section-inner { max-width: 1100px; margin: 0 auto; }
.section-title {
  font-family: var(--font-head);
  font-size: 2.2rem;
  font-weight: 700;
  letter-spacing: 1px;
  margin-bottom: 6px;
}
.section-sub { color: var(--muted); margin-bottom: 32px; }

.dl-spinner { color: var(--muted); font-size: 0.9rem; margin-bottom: 24px; }

/* Tabs */
.tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.tab {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--muted);
  font-family: var(--font-head);
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.5px;
}
.tab:hover { border-color: var(--accent); color: var(--text); }
.tab.active { border-color: var(--accent); color: var(--accent); background: rgba(10, 0, 200, 0.07); }
.tab-icon { width: 22px; height: 22px; border-radius: 4px; object-fit: cover; }

/* Panel */
.tech-panel { display: none; }
.tech-panel.active { display: block; }
.tech-desc { color: var(--muted); margin-bottom: 16px; font-size: 0.9rem; }

/* Version grid */
.version-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
.version-btn {
  padding: 8px 16px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 0.88rem;
  font-family: var(--font-body);
  cursor: pointer;
  transition: all 0.15s;
  display: flex; align-items: center; gap: 6px;
}
.version-btn:hover:not(.unavailable) { border-color: var(--accent2); color: var(--accent2); }
.version-btn.selected { border-color: var(--accent2); background: rgba(0,144,255,0.1); color: var(--accent2); }
.version-btn.unsupported { opacity: 0.7; }
.version-btn.unsupported:hover:not(.unavailable) { border-color: var(--warn); color: var(--warn); }
.version-btn.unsupported.selected { border-color: var(--warn); background: rgba(245,166,35,0.1); color: var(--warn); }
.version-btn.unavailable { opacity: 0.45; cursor: not-allowed; }
.v-badge {
  font-size: 0.7rem;
  padding: 1px 5px;
  border-radius: 3px;
  background: var(--surface);
  color: var(--muted);
  border: 1px solid var(--border);
}
.v-badge.unavail { color: var(--warn); border-color: var(--warn); }
.v-badge.beta-badge { color: #a78bfa; border-color: #a78bfa; }
.version-btn.beta:hover:not(.unavailable) { border-color: #a78bfa; color: #a78bfa; }
.version-btn.beta.selected { border-color: #a78bfa; background: rgba(167,139,250,0.1); color: #a78bfa; }

/* Download card */
.dl-card {
  position: relative;
  border-radius: 12px;
  border: 1px solid var(--border);
  overflow: hidden;
  margin-bottom: 12px;
}
.dl-bg {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0.2;
  transition: background-image 0.3s;
}
.dl-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50px 28px;
  gap: 16px;
  flex-wrap: wrap;
}
.dl-info { display: flex; flex-direction: column; gap: 4px; }
.dl-version {
  font-family: var(--font-head);
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: 1px;
}
.dl-note { font-size: 0.82rem; color: var(--warn); max-width: 500px; line-height: 1.4; }
.dl-btn {
  padding: 12px 32px;
  background: var(--accent);
  color: #000;
  font-weight: 700;
  font-family: var(--font-head);
  font-size: 1.1rem;
  border-radius: var(--radius);
  text-decoration: none;
  letter-spacing: 0.5px;
  transition: opacity 0.2s, transform 0.1s;
  white-space: nowrap;
}
.dl-btn:hover { opacity: 0.85; transform: translateY(-1px); text-decoration: none; }
.dl-btn.disabled {
  background: var(--surface2);
  color: var(--muted);
  cursor: not-allowed;
  pointer-events: none;
}
.dl-hint { color: var(--muted); font-size: 0.85rem; }

/* Modals */
.modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(4px);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal-overlay.open { display: flex; }
.modal {
  background: var(--surface);
  border: 1px solid var(--warn);
  border-radius: 14px;
  padding: 36px;
  max-width: 420px;
  width: calc(100% - 48px);
  text-align: center;
  box-shadow: 0 0 40px rgba(245,166,35,0.15);
  animation: modalIn 0.18s ease;
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95) translateY(8px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}
.modal-icon { font-size: 2.5rem; margin-bottom: 12px; }
.modal-title {
  font-family: var(--font-head);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--warn);
  margin-bottom: 12px;
}
.modal-body { font-size: 0.9rem; color: var(--muted); line-height: 1.7; margin-bottom: 28px; }
.modal-body strong { color: var(--text); }
.modal-actions { display: flex; gap: 10px; justify-content: center; }
.modal-cancel {
  padding: 10px 24px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: transparent;
  color: var(--muted);
  font-size: 0.9rem;
  cursor: pointer;
  transition: border-color 0.2s, color 0.2s;
}
.modal-cancel:hover { border-color: var(--text); color: var(--text); }
.modal-confirm {
  padding: 10px 24px;
  border-radius: var(--radius);
  background: var(--warn);
  color: #000;
  font-weight: 700;
  font-family: var(--font-head);
  font-size: 0.95rem;
  text-decoration: none;
  transition: opacity 0.2s;
}
.modal-confirm:hover { opacity: 0.85; text-decoration: none; }

/* Beta modal */
.modal-beta { border-color: #a78bfa; box-shadow: 0 0 40px rgba(167,139,250,0.15); }
.beta-title { color: #a78bfa; }
.beta-mods-section { margin-bottom: 20px; text-align: left; }
.beta-mods-label { font-size: 0.82rem; color: var(--muted); margin-bottom: 8px; }
.beta-mods-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-height: 150px;
  overflow-y: auto;
}
.beta-mods-list li {
  font-size: 0.85rem;
  padding: 4px 10px;
  background: rgba(167,139,250,0.08);
  border: 1px solid rgba(167,139,250,0.2);
  border-radius: 4px;
  color: #c4b5fd;
}
.beta-confirm { background: #a78bfa; }
</style>

<script>
  declare global {
    interface Window {
      renderDownloads: (categories: Record<string, any>, versionBackgrounds: Record<string, string>) => void;
      selectTech: (btn: HTMLElement) => void;
      selectVersion: (btn: HTMLElement) => void;
    }
  }

  let currentTech: string | null = null;

  // Called by the page-level script once API data is fetched
  window.renderDownloads = function(
    categories: Record<string, any>,
    versionBackgrounds: Record<string, string>
  ) {
    function ea(s: unknown) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function eh(s: unknown) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    const names = Object.keys(categories);

    const tabsHtml = names.map((name, i) => {
      const cat = categories[name];
      return `<button class="tab${i === 0 ? ' active' : ''}" data-tech="${ea(name)}" onclick="selectTech(this)">
        <img src="${ea(cat.icon)}" alt="${ea(name)}" class="tab-icon" onerror="this.style.display='none'" />${eh(name)}</button>`;
    }).join('');

    const panelsHtml = names.map((name, i) => {
      const cat = categories[name];
      const versionsHtml = (cat.versions as any[]).map(v => {
        const label: string = v.label || '';
        const bg = (versionBackgrounds[label] || versionBackgrounds[label.replace(/\s.+/, '').trim()] || '');
        const classes = ['version-btn'];
        if (!v.supported) classes.push('unsupported');
        if (!v.url) classes.push('unavailable');
        if (v.beta) classes.push('beta');
        const mods = v.unsupportedMods ? JSON.stringify(v.unsupportedMods) : '';
        return `<button class="${classes.join(' ')}"
          data-url="${ea(v.url || '')}" data-note="${ea(v.note || '')}" data-label="${ea(label)}"
          data-bg="${ea(bg)}" data-beta="${v.beta ? 'true' : ''}" data-unsupported-mods="${ea(mods)}"
          onclick="selectVersion(this)">
          <span class="v-label">${eh(label)}</span>
          ${v.beta ? '<span class="v-badge beta-badge">Beta</span>' : ''}
          ${!v.supported ? '<span class="v-badge">Unsupported</span>' : ''}
          ${!v.url ? '<span class="v-badge unavail">Soon</span>' : ''}
        </button>`;
      }).join('');

      return `<div class="tech-panel${i === 0 ? ' active' : ''}" data-tech="${ea(name)}" id="panel-${ea(name)}">
        <p class="tech-desc">${eh(cat.description)}</p>
        <div class="version-grid">${versionsHtml}</div>
      </div>`;
    }).join('');

    const tabsEl = document.getElementById('techTabs');
    const panelsEl = document.getElementById('techPanels');
    if (tabsEl) { tabsEl.innerHTML = tabsHtml; tabsEl.style.display = ''; }
    if (panelsEl) panelsEl.innerHTML = panelsHtml;
    const spinner = document.getElementById('dlSpinner');
    if (spinner) spinner.style.display = 'none';
    const hint = document.getElementById('dlHint');
    if (hint) hint.style.display = 'block';

    const firstTab = document.querySelector<HTMLElement>('.tab');
    if (firstTab) window.selectTech(firstTab);
  };

  window.selectTech = function(btn: HTMLElement) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tech-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    currentTech = btn.dataset.tech ?? null;
    if (currentTech) document.getElementById(`panel-${currentTech}`)?.classList.add('active');
    document.querySelectorAll('.version-btn').forEach(b => b.classList.remove('selected'));
    const card = document.getElementById('dlCard');
    if (card) card.style.display = 'none';
    const hint = document.getElementById('dlHint');
    if (hint) hint.style.display = 'block';
  };

  window.selectVersion = function(btn: HTMLElement) {
    if (btn.classList.contains('unavailable')) return;
    document.querySelectorAll('.version-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');

    const url = btn.dataset.url ?? '';
    const note = btn.dataset.note ?? '';
    const label = btn.dataset.label ?? '';
    const bg = btn.dataset.bg ?? '';
    const isLegacy = btn.classList.contains('unsupported');
    const isBeta = btn.dataset.beta === 'true';
    const unsupportedMods: string[] = btn.dataset.unsupportedMods ? JSON.parse(btn.dataset.unsupportedMods) : [];

    const card = document.getElementById('dlCard') as HTMLElement | null;
    const dlBtn = document.getElementById('dlBtn') as HTMLAnchorElement | null;
    if (!card || !dlBtn) return;

    const verEl = document.getElementById('dlVersion');
    if (verEl) verEl.textContent = `${currentTech} — ${label}`;
    const noteEl = document.getElementById('dlNote');
    if (noteEl) noteEl.textContent = note;
    const bgEl = document.getElementById('dlBg') as HTMLElement | null;
    if (bgEl) bgEl.style.backgroundImage = bg ? `url(${bg})` : 'none';

    if (isBeta) {
      card.style.borderColor = 'rgba(167,139,250,0.5)';
    } else if (isLegacy) {
      card.style.borderColor = 'rgba(245,166,35,0.5)';
    } else {
      card.style.borderColor = '';
    }

    if (url) {
      dlBtn.href = url;
      dlBtn.classList.remove('disabled');
      if (isBeta) {
        dlBtn.textContent = 'Download (Beta) ↓';
        dlBtn.style.background = '#a78bfa';
        dlBtn.onclick = (e) => { e.preventDefault(); openBetaModal(url, unsupportedMods); };
      } else if (isLegacy) {
        dlBtn.textContent = 'Download (Unsupported) ↓';
        dlBtn.style.background = 'var(--warn)';
        dlBtn.onclick = (e) => { e.preventDefault(); openLegacyModal(url); };
      } else {
        dlBtn.textContent = 'Download ↓';
        dlBtn.style.background = '';
        dlBtn.onclick = null;
      }
    } else {
      dlBtn.href = '#';
      dlBtn.classList.add('disabled');
      dlBtn.textContent = 'Not Available Yet';
      dlBtn.style.background = '';
      dlBtn.onclick = null;
    }

    card.style.display = 'block';
    const hint = document.getElementById('dlHint');
    if (hint) hint.style.display = 'none';
  };

  function openBetaModal(url: string, unsupportedMods: string[]) {
    const dlBtn = document.getElementById('betaDlBtn') as HTMLAnchorElement | null;
    if (dlBtn) dlBtn.href = url;
    const modsSection = document.getElementById('betaModsSection') as HTMLElement | null;
    const modsList = document.getElementById('betaModsList') as HTMLElement | null;
    if (unsupportedMods.length > 0) {
      if (modsList) modsList.innerHTML = unsupportedMods.map(m => `<li>${m}</li>`).join('');
      if (modsSection) modsSection.style.display = 'block';
    } else {
      if (modsSection) modsSection.style.display = 'none';
    }
    document.getElementById('betaModal')?.classList.add('open');
  }

  function closeBetaModal() {
    document.getElementById('betaModal')?.classList.remove('open');
  }

  document.getElementById('betaModalCancel')?.addEventListener('click', closeBetaModal);
  document.getElementById('betaDlBtn')?.addEventListener('click', closeBetaModal);
  document.getElementById('betaModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeBetaModal();
  });

  function openLegacyModal(url: string) {
    const dlBtn = document.getElementById('modalDlBtn') as HTMLAnchorElement | null;
    if (dlBtn) dlBtn.href = url;
    document.getElementById('legacyModal')?.classList.add('open');
  }

  function closeLegacyModal() {
    document.getElementById('legacyModal')?.classList.remove('open');
  }

  document.getElementById('legacyModalCancel')?.addEventListener('click', closeLegacyModal);
  document.getElementById('modalDlBtn')?.addEventListener('click', closeLegacyModal);
  document.getElementById('legacyModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeLegacyModal();
  });
</script>
